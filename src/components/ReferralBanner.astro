---
interface Props { placement?: 'home' | 'diagnose'; }
const { placement = 'diagnose' } = Astro.props;
const referralUrl = new URL('https://youtujsq9.net/');

referralUrl.searchParams.set('utm_source', 'low_latency_lab');
referralUrl.searchParams.set('utm_medium', 'referral');
referralUrl.searchParams.set('utm_campaign', placement === 'home' ? 'home_banner' : 'diagnose_banner');
---

<aside class="referral-banner" aria-label="优途加速器广告" data-referral-placement={placement}>
  <div class="referral-copy">
    <p class="referral-label">广告 · 优途加速器</p>
    <h2>游戏连接不稳定？了解一下优途加速器</h2>
    <p>
      有些游戏连接问题可能与网络路径有关。先排查家里的网络，再看看加速服务是否适合你玩的游戏。
    </p>
  </div>

  <a
    class="referral-link"
    href={referralUrl.href}
    target="_blank"
    rel="sponsored noopener noreferrer"
    data-referral-banner
  >
    查看优途加速器
    <span aria-hidden="true">→</span>
  </a>

  <p class="referral-disclosure">
    加速效果因游戏和网络环境而异，不能解决设备掉帧或 Wi-Fi 信号差等问题。
  </p>
</aside>

<script is:inline>
  // A view requires at least 50% of the banner on screen, with the tab visible,
  // for one uninterrupted second. Analytics may still be blocked by the browser.
  document.querySelectorAll('[data-referral-placement]').forEach((banner) => {
    if (banner.dataset.referralInitialized === 'true') return;
    banner.dataset.referralInitialized = 'true';
    const details = {
      ad_partner: 'youtu',
      placement: banner.getAttribute('data-referral-placement') || 'unknown',
      page_path: location.pathname,
    };
    const emit = (name) => {
      if (typeof window.gtag !== 'function') return false;
      window.gtag('event', name, details);
      return true; // event queued, not evidence of GA4 receipt
    };
    const link = banner.querySelector('[data-referral-banner]');
    if (link) link.addEventListener('click', () => emit('referral_banner_click'));
    if (!('IntersectionObserver' in window)) return;

    let timer = null;
    let ratio = 0;
    let viewQualified = false;
    let viewSent = false;
    let retryTimer = null;
    const clearViewTimer = () => {
      if (timer !== null) clearTimeout(timer);
      timer = null;
    };
    const isVisible = () => document.visibilityState === 'visible' && ratio >= 0.5;
    const trySend = () => {
      if (!viewQualified || viewSent) return;
      if (emit('referral_banner_view')) {
        viewSent = true;
        if (retryTimer !== null) clearInterval(retryTimer);
        retryTimer = null;
      }
    };
    const startIfVisible = () => {
      if (!isVisible() || viewQualified || timer !== null) return;
      timer = setTimeout(() => {
        timer = null;
        if (!isVisible() || viewQualified) return;
        viewQualified = true;
        trySend();
        // The analytics library may arrive after the visible impression.
        // Retry briefly, without counting it twice.
        if (!viewSent) {
          let attempts = 0;
          retryTimer = setInterval(() => {
            attempts += 1;
            trySend();
            if (viewSent || attempts >= 10) {
              clearInterval(retryTimer);
              retryTimer = null;
            }
          }, 500);
        }
      }, 1000);
    };
    const observer = new IntersectionObserver((entries) => {
      const entry = entries.find((entry) => entry.target === banner);
      if (!entry) return;
      ratio = entry.intersectionRatio;
      if (!isVisible()) clearViewTimer();
      else startIfVisible();
    }, { threshold: [0, 0.5, 1] });
    const onVisibilityChange = () => {
      if (!isVisible()) clearViewTimer();
      else startIfVisible();
    };
    document.addEventListener('visibilitychange', onVisibilityChange);
    observer.observe(banner);
    window.addEventListener('pagehide', () => {
      clearViewTimer();
      if (retryTimer !== null) clearInterval(retryTimer);
      observer.disconnect();
      document.removeEventListener('visibilitychange', onVisibilityChange);
    }, { once: true });
  });
</script>

<style>
  .referral-banner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 22px 34px;
    align-items: center;
    margin: 0 0 72px;
    padding: 30px;
    color: var(--white);
    background: var(--ink);
    border-top: 4px solid var(--signal);
  }

  .referral-copy {
    min-width: 0;
  }

  .referral-label {
    margin: 0 0 8px;
    color: var(--signal);
    font-size: 0.76rem;
    font-weight: 850;
  }

  .referral-copy h2 {
    margin: 0;
    color: var(--white);
    font-size: 1.45rem;
    line-height: 1.3;
  }

  .referral-copy > p:last-child {
    max-width: 620px;
    margin: 12px 0 0;
    color: #c9d3d0;
    font-size: 0.94rem;
  }

  .referral-link {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 11px 18px;
    color: #071716;
    background: var(--signal);
    border: 1px solid var(--signal);
    border-radius: 4px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .referral-link:hover {
    background: #5cebd3;
    transform: translateY(-2px);
  }

  .referral-link span {
    transition: transform 0.18s ease;
  }

  .referral-link:hover span {
    transform: translateX(3px);
  }

  .referral-disclosure {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 18px;
    color: #9fadaa;
    border-top: 1px solid var(--line-dark);
    font-size: 0.78rem;
  }

  @media (max-width: 720px) {
    .referral-banner {
      grid-template-columns: 1fr;
      padding: 24px 22px;
    }

    .referral-link {
      width: 100%;
    }
  }

  @media print {
    .referral-banner {
      display: none;
    }
  }
</style>
