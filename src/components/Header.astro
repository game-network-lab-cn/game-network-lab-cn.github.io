---
import { navItems, pathWithBase } from '../data/site';
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={pathWithBase('/')} aria-label="低延迟实验室首页">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>低延迟实验室</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {navItems.map((item) => <a href={pathWithBase(item.href)}>{item.label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary aria-label="打开导航"><span></span><span></span><span></span></summary>
      <nav aria-label="移动端导航">
        {navItems.map((item) => <a href={pathWithBase(item.href)}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
