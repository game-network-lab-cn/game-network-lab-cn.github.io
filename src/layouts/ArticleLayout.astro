---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DirectAnswer from '../components/DirectAnswer.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import {
  articleBySlug,
  type Article,
} from '../data/articles';
import {
  SITE_NAME,
  pathWithBase,
} from '../data/site';

interface Props {
  article: Article;
}

const { article } = Astro.props;

const sectionLabel =
  article.section === 'metrics'
    ? '认识指标'
    : '诊断指南';

const articleUrl = new URL(
  pathWithBase(`/${article.section}/${article.slug}/`),
  Astro.site || Astro.url.origin,
).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    datePublished: article.publishedDate,
    dateModified: article.updatedDate,
    inLanguage: 'zh-CN',
    author: {
      '@type': 'Organization',
      name: SITE_NAME,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
    },
    mainEntityOfPage: articleUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: new URL(
          pathWithBase('/'),
          Astro.site || Astro.url.origin,
        ).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: sectionLabel,
        item: new URL(pathWithBase(`/${article.section}/`), Astro.site || Astro.url.origin).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: article.title,
        item: articleUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={article.title}
  description={article.description}
  schema={schema}
  socialType="article"
>
  <div class="article-shell">
    <Breadcrumbs
      items={[
        {
          label: '首页',
          href: '/',
        },
        {
          label: sectionLabel,
          href: `/${article.section}/`,
        },
        {
          label: article.title,
        },
      ]}
    />

    <header class="article-header">
      <p class="eyebrow">{article.eyebrow}</p>
      <h1>{article.title}</h1>
      <p class="article-deck">{article.description}</p>

      <div class="article-meta">
        <span>发布于 {article.publishedDate}</span>
        {
          article.updatedDate !== article.publishedDate && (
            <span>更新于 {article.updatedDate}</span>
          )
        }
        <span>{article.readTime}</span>
      </div>
    </header>

    <div class="article-grid">
      <article class="article-body">
        <DirectAnswer text={article.answer} />

        {article.takeaways && article.takeaways.length > 0 && (
          <section class="key-points" aria-labelledby="key-points-heading">
            <h2 id="key-points-heading">关键区别</h2>
            <ol>{article.takeaways.map((takeaway) => <li>{takeaway}</li>)}</ol>
          </section>
        )}

        {
          article.sections.map((section) => (
            <section data-reveal>
              <h2>{section.heading}</h2>

              {
                section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))
              }

              {
                section.bullets && (
                  <ul>
                    {
                      section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))
                    }
                  </ul>
                )
              }
            </section>
          ))
        }

        <section class="source-section" data-reveal>
          <h2>依据与延伸阅读</h2>
          <p>这些资料用于理解相关术语和工具的适用范围；实际网络结果还取决于测量目标与环境。</p>

          <ul class="source-list">
            {
              article.sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {source.title}
                  </a>
                  <span>{source.publisher}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <ReferralBanner />
      </article>

      <aside
        class="article-aside"
        aria-label="相关内容"
      >
        <div class="aside-sticky">
          <p class="aside-label">下一步</p>
          <h2>把判断变成一组对照</h2>
          <p>
            先用诊断分析器查看连续样本的尖峰和超时，再保存对照条件。
          </p>

          <a
            class="text-link"
            href={pathWithBase('/tools/network-analyzer/')}
          >
            打开网络诊断分析器
            <span aria-hidden="true">→</span>
          </a>

          <div class="aside-related">
            <p class="aside-label">相关指南</p>

            {
              article.related.map((slug) => {
                const related = articleBySlug.get(slug);

                return (
                  related && (
                    <a
                      href={pathWithBase(
                        `/${related.section}/${related.slug}/`,
                      )}
                    >
                      {related.title}
                    </a>
                  )
                );
              })
            }
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
