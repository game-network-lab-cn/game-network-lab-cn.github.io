---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/articles';
import { pathWithBase } from '../data/site';

const featured = [
  articles.find((a) => a.slug === 'game-lag-diagnostic-tree'),
  articles.find((a) => a.slug === 'game-network-quality'),
  articles.find((a) => a.slug === 'low-ping-but-lag'),
  articles.find((a) => a.slug === 'packet-delay-variation'),
].filter(Boolean);

const symptoms = [
  { label: '角色瞬移或回弹', title: '先看连续丢包与短时尖峰', body: '记录卡顿发生时刻，再把它与连续 RTT、最长连续丢包对齐。平均值正常也不能排除短时异常。', href: '/metrics/burst-packet-loss/' },
  { label: 'Ping 突然升高', title: '先判断尖峰从家庭网络还是外部路径开始', body: '先测家庭网关，再做有线与 Wi-Fi、空闲与负载的单变量对照，近端稳定后才继续看外部路径。', href: '/diagnose/game-lag-diagnostic-tree/' },
  { label: '低 Ping 仍然卡', title: '同时看帧时间、尖峰和丢包分布', body: '游戏内的低数值可能经过平滑，也可能与本机性能问题并存。把网络曲线与帧时间放在同一时间线上。', href: '/diagnose/low-ping-but-lag/' },
  { label: '语音断续', title: '检查稳定性，不只检查平均延迟', body: '语音对连续到达更敏感。观察延迟波动、连续丢失和上行负载，尤其留意后台上传发生的时段。', href: '/metrics/packet-delay-variation/' },
  { label: '只在 Wi-Fi 卡', title: '用有线对照隔离无线接入问题', body: '保持设备、服务器和时段不变，只把 Wi-Fi 换成有线。如果异常明显消失，再检查信号、干扰、频段与网卡。', href: '/diagnose/game-lag-diagnostic-tree/' },
];
---

<BaseLayout>
  <section class="hero" style={`--hero-image: url('${pathWithBase('/images/latency-lab-hero.webp')}')`}>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-brand">低延迟实验室</p>
        <h1>游戏网络问题，先测清楚再动设置。</h1>
        <p class="hero-lead">从 Ping、丢包和延迟波动出发，用单变量对照定位家庭网络、路径或服务器侧线索。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#symptoms">按症状开始诊断 <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href={pathWithBase('/metrics/game-network-quality/')}>认识四个指标</a>
        </div>
        <p class="hero-proof">不设万能阈值 · 不凭单次截图定责 · 不收集你的测试数据</p>
      </div>
    </div>
  </section>

  <div class="signal-strip" aria-label="本站主题">
    <div class="signal-strip-inner"><span>RTT 往返时延</span><span>Packet Loss 丢包</span><span>Delay Variation 延迟波动</span><span>Route 路径线索</span></div>
  </div>

  <section class="section" id="symptoms">
    <div class="section-inner">
      <p class="section-kicker">症状入口</p>
      <h2 class="section-heading">你遇到的是哪一种卡？</h2>
      <p class="section-intro">先选择可观察的症状，再进入对应的测量。一次只改变一个条件，结果才有解释力。</p>
      <div class="diagnostic-workbench" data-diagnostic data-reveal>
        <div class="symptom-list" role="tablist" aria-label="选择网络症状">
          {symptoms.map((item, index) => <button class="symptom-button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-index={index}><span>{item.label}</span><span>{String(index + 1).padStart(2, '0')}</span></button>)}
        </div>
        <div class="symptom-panel" role="tabpanel" aria-live="polite">
          <span class="panel-index">DIAGNOSIS 01</span>
          <h3>{symptoms[0].title}</h3>
          <p>{symptoms[0].body}</p>
          <a class="text-link" href={pathWithBase(symptoms[0].href)}>查看这条诊断路径 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="section-inner">
      <p class="section-kicker">诊断方法</p>
      <h2 class="section-heading">从现象到证据，只走三步。</h2>
      <p class="section-intro">测量的目的不是得到一个漂亮数字，而是排除错误方向。</p>
      <div class="workflow" data-reveal>
        <div class="workflow-step"><span class="step-number">01 / REPRODUCE</span><h3>复现并记时</h3><p>记录准确时间、服务器区域、连接方式和可观察症状。</p></div>
        <div class="workflow-step"><span class="step-number">02 / COMPARE</span><h3>只改一个变量</h3><p>用有线对 Wi-Fi、空闲对负载、正常时段对异常时段。</p></div>
        <div class="workflow-step"><span class="step-number">03 / LOCATE</span><h3>从近到远定位</h3><p>家庭网关稳定后，再检查外部目标、路径和游戏服务线索。</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">指标地图</p>
      <h2 class="section-heading">四个指标，回答四个不同问题。</h2>
      <table class="metric-table" data-reveal>
        <thead><tr><th>指标</th><th>它回答什么</th><th>常见误区</th><th>深入阅读</th></tr></thead>
        <tbody>
          <tr><td>RTT</td><td>一次往返用了多久</td><td>把 Ping 工具和 RTT 指标完全等同</td><td><a href={pathWithBase('/metrics/ping-vs-rtt/')}>Ping 与 RTT</a></td></tr>
          <tr><td>丢包</td><td>数据有没有按测量条件完成往返</td><td>只看平均比例，不看连续分布</td><td><a href={pathWithBase('/metrics/burst-packet-loss/')}>突发丢包</a></td></tr>
          <tr><td>延迟波动</td><td>连续到达是否稳定</td><td>跨工具比较不同的 jitter 算法</td><td><a href={pathWithBase('/metrics/packet-delay-variation/')}>延迟波动</a></td></tr>
          <tr><td>路径</td><td>异常可能从哪里开始</td><td>把中间节点不响应当作业务丢包</td><td><a href={pathWithBase('/diagnose/game-lag-diagnostic-tree/')}>诊断树</a></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="section-inner">
      <p class="section-kicker">首发指南</p>
      <h2 class="section-heading">从最常见的误判开始。</h2>
      <div class="guide-list" data-reveal>
        {featured.map((article, index) => article && (
          <a class="guide-row" href={pathWithBase(`/${article.section}/${article.slug}/`)}>
            <small>{String(index + 1).padStart(2, '0')} · {article.readTime}</small><h3>{article.title}</h3><span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="section-inner tool-band">
      <div>
        <p class="section-kicker">可复现记录</p>
        <h2 class="section-heading">把“感觉很卡”变成可复核的证据。</h2>
        <p class="section-intro">模板只在浏览器本地填写，不会上传。打印或保存为 PDF 前，先遮盖公网 IP、账号和设备标识。</p>
        <p style="margin-top: 28px"><a class="button button-primary" href={pathWithBase('/tools/network-test-record/')}>打开记录模板</a></p>
      </div>
      <div class="record-preview" aria-label="测试记录预览" data-reveal>
        <div class="record-line"><span>TIME</span><span>2026-08-21 20:30</span></div>
        <div class="record-line"><span>ACCESS</span><span>Ethernet / Wi-Fi 对照</span></div>
        <div class="record-line"><span>TARGET</span><span>服务器区域与测试目标</span></div>
        <div class="record-line"><span>RTT</span><span>avg / max / time-series</span></div>
        <div class="record-line"><span>LOSS</span><span>total / longest burst</span></div>
        <div class="record-line"><span>CHANGE</span><span>本轮只改变的一个条件</span></div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="closing-inner"><h2>先保留一份完整记录，再决定下一步。</h2><a class="button" href={pathWithBase('/diagnose/game-lag-diagnostic-tree/')}>进入完整诊断树 <span aria-hidden="true">→</span></a></div>
  </section>

  <script define:vars={{ symptoms, base: import.meta.env.BASE_URL }} is:inline>
    const root = document.querySelector('[data-diagnostic]');
    if (root) {
      const buttons = root.querySelectorAll('[role="tab"]');
      const panel = root.querySelector('[role="tabpanel"]');
      buttons.forEach((button) => button.addEventListener('click', () => {
        const index = Number(button.dataset.index);
        const item = symptoms[index];
        buttons.forEach((candidate) => candidate.setAttribute('aria-selected', String(candidate === button)));
        const normalizedBase = base.replace(/\/$/, '');
        panel.innerHTML = `<span class="panel-index">DIAGNOSIS ${String(index + 1).padStart(2, '0')}</span><h3>${item.title}</h3><p>${item.body}</p><a class="text-link" href="${normalizedBase}${item.href}">查看这条诊断路径 <span aria-hidden="true">→</span></a>`;
      }));
    }
  </script>
</BaseLayout>
