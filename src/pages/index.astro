---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import { articles } from '../data/articles';
import { pathWithBase } from '../data/site';

const featured = [
  articles.find((a) => a.slug === 'game-lag-diagnostic-tree'),
  articles.find((a) => a.slug === 'game-network-quality'),
  articles.find((a) => a.slug === 'low-ping-but-lag'),
  articles.find((a) => a.slug === 'packet-delay-variation'),
].filter(Boolean);

const symptoms = [
  {
    label: '角色瞬移或回弹',
    title: '人物瞬移，不一定就是丢包',
    body: '先记录卡顿发生时刻，并对照游戏帧时间、连续 RTT 和超时样本。单凭瞬移现象不能认定存在丢包。',
    href: '/diagnose/game-lag-diagnostic-tree/',
  },
  {
    label: 'Ping 突然升高',
    title: 'Ping 突然变高，先查家里的网络',
    body: '先看看家里的网络是否正常，再对比网线和 Wi-Fi。如果只有玩游戏时延迟升高，还可以检查后台上传和外部连接。',
    href: '/diagnose/ping-spikes-while-gaming/',
  },
  {
    label: '低 Ping 仍然卡',
    title: 'Ping 不高却卡，可能不只是网络问题',
    body: '游戏内的低数值可能经过平滑，也可能与本机性能问题并存。把网络曲线与帧时间放在同一时间线上。',
    href: '/diagnose/low-ping-but-lag/',
  },
  {
    label: '语音断续',
    title: '语音断断续续，看看网络有没有突然波动',
    body: '语音对连续到达更敏感。观察延迟波动、连续丢失和上行负载，尤其留意后台上传发生的时段。',
    href: '/metrics/packet-delay-variation/',
  },
  {
    label: '只在 Wi-Fi 卡',
    title: '只有 Wi-Fi 卡，先试试网线',
    body: '保持设备、服务器和时段不变，只把 Wi-Fi 换成有线。如果异常明显消失，再检查信号、干扰、频段与网卡。',
    href: '/diagnose/wifi-gaming-lag/',
  },
];
---

<BaseLayout>
  <section
    class="hero"
    style={`--hero-image: url('${pathWithBase('/images/latency-lab-hero.webp')}')`}
  >
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-brand">低延迟实验室</p>
        <h1>游戏卡顿、延迟高、总掉线？先找到原因。</h1>
        <p class="hero-lead">
          打游戏突然卡一下，或者 Ping 一直跳？按症状排查 Wi-Fi、家里网络和游戏服务器，看看问题可能出在哪。
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#symptoms">
            按症状开始诊断 <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href={pathWithBase('/tools/network-analyzer/')}>
            分析测试数据
          </a>
        </div>

        <p class="hero-proof">不用注册账号 · 测试数据留在浏览器里</p>
      </div>
    </div>
  </section>

  <div class="signal-strip" aria-label="本站主题">
    <div class="signal-strip-inner">
      <span>RTT 往返时延</span>
      <span>Packet Loss 丢包</span>
      <span>Delay Variation 延迟波动</span>
      <span>Route 路径线索</span>
    </div>
  </div>

  <section class="section" id="symptoms">
    <div class="section-inner">
      <p class="section-kicker">常见卡顿情况</p>
      <h2 class="section-heading">玩游戏时，你遇到了什么问题？</h2>
      <p class="section-intro">
        选一个最接近的情况，看看可以先检查哪里。
      </p>

      <div class="diagnostic-workbench" data-diagnostic data-reveal>
        <div class="symptom-list" role="group" aria-label="选择网络症状">
          {
            symptoms.map((item, index) => (
              <button
                class="symptom-button"
                type="button"
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-index={index}
              >
                <span>{item.label}</span>
                <span>{String(index + 1).padStart(2, '0')}</span>
              </button>
            ))
          }
        </div>

        <div class="symptom-panel" aria-live="polite" aria-atomic="true">
          <span class="panel-index" data-panel-index>问题 01</span>
          <h3 data-panel-title>{symptoms[0].title}</h3>
          <p data-panel-body>{symptoms[0].body}</p>
          <a class="text-link" data-panel-link href={pathWithBase(symptoms[0].href)}>
            查看排查方法 <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-label="优途加速器推广">
    <div class="section-inner">
      <ReferralBanner placement="home" />
    </div>
  </section>

  <section class="section section-dark">
    <div class="section-inner">
      <p class="section-kicker">怎么排查</p>
      <h2 class="section-heading">不知道哪里出了问题？从这三步开始。</h2>
      <p class="section-intro">先看看卡顿什么时候出现，再比较不同网络下有没有变化。</p>

      <div class="workflow" data-reveal>
        <div class="workflow-step">
          <span class="step-number">01</span>
          <h3>记下卡顿发生的时间</h3>
          <p>记下当时玩的游戏、服务器、使用 Wi-Fi 还是网线，以及具体是延迟高、瞬移还是掉线。</p>
        </div>

        <div class="workflow-step">
          <span class="step-number">02</span>
          <h3>换一种连接方式试试</h3>
          <p>先用网线和 Wi-Fi 分别试一次，再看看后台上传文件时会不会更卡。</p>
        </div>

        <div class="workflow-step">
          <span class="step-number">03</span>
          <h3>再查外部网络</h3>
          <p>如果家里的网络测试稳定，再检查外部连接和游戏服务器有没有异常。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">认识网络指标</p>
      <h2 class="section-heading">游戏网络里的几个数字，分别是什么意思？</h2>

      <table class="metric-table" data-reveal>
        <thead>
          <tr>
            <th>指标</th>
            <th>它回答什么</th>
            <th>常见误区</th>
            <th>深入阅读</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>RTT</td>
            <td>一次往返用了多久</td>
            <td>把 Ping 工具和 RTT 指标完全等同</td>
            <td><a href={pathWithBase('/metrics/ping-vs-rtt/')}>Ping 与 RTT</a></td>
          </tr>
          <tr>
            <td>丢包</td>
            <td>数据有没有按测量条件完成往返</td>
            <td>只看平均比例，不看连续分布</td>
            <td><a href={pathWithBase('/metrics/burst-packet-loss/')}>突发丢包</a></td>
          </tr>
          <tr>
            <td>延迟波动</td>
            <td>连续到达是否稳定</td>
            <td>跨工具比较不同的 jitter 算法</td>
            <td>
              <a href={pathWithBase('/metrics/packet-delay-variation/')}>延迟波动</a>
            </td>
          </tr>
          <tr>
            <td>路径</td>
            <td>异常可能从哪里开始</td>
            <td>把中间节点不响应当作业务丢包</td>
            <td>
              <a href={pathWithBase('/diagnose/game-lag-diagnostic-tree/')}>诊断树</a> · <a href={pathWithBase('/diagnose/wifi-gaming-lag/')}>Wi-Fi 卡顿排查</a> · <a href={pathWithBase('/diagnose/ping-spikes-while-gaming/')}>Ping 突然升高</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="section-inner">
      <p class="section-kicker">常见问题</p>
      <h2 class="section-heading">常见游戏网络问题</h2>

      <div class="guide-list" data-reveal>
        {
          featured.map(
            (article, index) =>
              article && (
                <a
                  class="guide-row"
                  href={pathWithBase(`/${article.section}/${article.slug}/`)}
                >
                  <small>
                    {String(index + 1).padStart(2, '0')} · {article.readTime}
                  </small>
                  <h3>{article.title}</h3>
                  <span aria-hidden="true">→</span>
                </a>
              ),
          )
        }
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="section-inner tool-band">
      <div>
        <p class="section-kicker">保存测试结果</p>
        <h2 class="section-heading">把测试结果记下来，方便前后比较。</h2>
        <p class="section-intro">
          模板只在浏览器本地填写，不会上传。打印或保存为 PDF
          前，先遮盖公网 IP、账号和设备标识。
        </p>
        <p style="margin-top: 28px">
          <a class="button button-primary" href={pathWithBase('/tools/network-test-record/')}>
            打开记录模板
          </a>
        </p>
      </div>

      <div class="record-preview" aria-label="测试记录格式预览" data-reveal>
        <div class="record-line"><span>TIME</span><span>YYYY-MM-DD HH:MM</span></div>
        <div class="record-line">
          <span>ACCESS</span><span>Ethernet / Wi-Fi 对照</span>
        </div>
        <div class="record-line">
          <span>TARGET</span><span>服务器区域与测试目标</span>
        </div>
        <div class="record-line">
          <span>RTT</span><span>avg / max / time-series</span>
        </div>
        <div class="record-line">
          <span>LOSS</span><span>total / longest burst</span>
        </div>
        <div class="record-line">
          <span>CHANGE</span><span>本轮只改变的一个条件</span>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="closing-inner">
      <h2>卡顿反复出现？按步骤再查一遍。</h2>
      <a class="button" href={pathWithBase('/diagnose/game-lag-diagnostic-tree/')}>
        查看完整排查指南 <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <script define:vars={{ symptoms, base: import.meta.env.BASE_URL }} is:inline>
    const root = document.querySelector('[data-diagnostic]');

    if (root) {
      const buttons = root.querySelectorAll('.symptom-button');
      const indexNode = root.querySelector('[data-panel-index]');
      const titleNode = root.querySelector('[data-panel-title]');
      const bodyNode = root.querySelector('[data-panel-body]');
      const linkNode = root.querySelector('[data-panel-link]');

      buttons.forEach((button) =>
        button.addEventListener('click', () => {
          const index = Number(button.dataset.index);
          const item = symptoms[index];

          buttons.forEach((candidate) =>
            candidate.setAttribute('aria-pressed', String(candidate === button)),
          );
          const normalizedBase = base.replace(/\/$/, '');
          indexNode.textContent = `问题 ${String(index + 1).padStart(2, '0')}`;
          titleNode.textContent = item.title;
          bodyNode.textContent = item.body;
          linkNode.href = `${normalizedBase}${item.href}`;
        }),
      );
    }
  </script>
</BaseLayout>
